// Сравниваем [2]

// возвращает срез проводов только из указанного материала
func selectMaterial(s []Wire) []Wire {
	var selM []Wire
	for i := 0; i < len(s); i++ {
		if s[i].Material == "copper" {
			selM = append(selM, s[i])
		}
	}
	return selM
}
